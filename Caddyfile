{ # global options
    admin off
    persist_config off
    auto_https off
    log {
        format console
    }
    servers {
        trusted_proxies static private_ranges
    }
}

:{$PORT} {
    log {
        format console
    }

    # Handle requests for /ws/* first, and proxy them to the backend
    handle /ws/* {
        reverse_proxy {$BACKEND_HOST}
    }

    # All other requests (that didn't match /ws/*) go to the frontend
    handle {
        reverse_proxy {$FRONTEND_HOST}
    }
}
